# Server Port
PORT=4000

# PostgreSQL (Matches docker-compose.yml port 5433)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/collabarch?schema=public"

# Redis Pub/Sub Mesh (Matches docker-compose.yml port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# Clerk Authentication Secret Key (From Clerk Dashboard)
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
