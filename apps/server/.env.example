# Server Port
PORT=4000

# CORS Whitelist (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Matches docker-compose.yml port 5433)
# connection_limit & pool_timeout tuned for concurrent Yjs room snapshots
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/collabarch?schema=public&connection_limit=25&pool_timeout=15"

# Redis Pub/Sub Mesh (Matches docker-compose.yml port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
# Optional Redis URL (e.g. rediss://:pass@cloud-host:6379 for TLS/Cloud)
# REDIS_URL=

# Clerk Authentication Secret Key (From Clerk Dashboard)
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Clerk Webhook Secret (From Clerk Dashboard Webhooks -> Svix Endpoint Signing Secret)
CLERK_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# Dev Auth Bypass Toggle (Set 'true' strictly for automated local testing without Clerk credentials)
ENABLE_DEV_AUTH_BYPASS=false

# Google Gemini API Key & Model (From https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
