# ==============================================================================
# CollabArch Production Environment Variables Template
# Copy this file to .env.production on your server and populate sensitive values.
# DO NOT commit real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Docker Compose internal or External Managed DB)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_production_password_min_32_chars
POSTGRES_DB=collabarch
POSTGRES_PORT=5432

# In Docker Compose, the connection string references the service name 'postgres':
DATABASE_URL="postgresql://postgres:replace_with_a_secure_production_password_min_32_chars@postgres:5432/collabarch?schema=public&connection_limit=25&pool_timeout=15"

# ------------------------------------------------------------------------------
# Redis Pub/Sub Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=4000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (NO trailing slashes)
ALLOWED_ORIGINS=https://collabarch.yourdomain.com,https://www.collabarch.yourdomain.com

# STRICTLY disabled in production
ENABLE_DEV_AUTH_BYPASS=false

# ------------------------------------------------------------------------------
# Clerk Authentication (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
# Backend & Next.js Server-side Secret Key (begins with sk_live_ or sk_test_)
CLERK_SECRET_KEY=sk_live_replace_with_your_actual_clerk_secret_key

# Webhook signing secret (From Clerk Dashboard -> Webhooks -> Endpoint Secret)
CLERK_WEBHOOK_SECRET=whsec_replace_with_your_actual_webhook_secret

# Public publishable key for client bundle (begins with pk_live_ or pk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_your_actual_clerk_publishable_key

# Clerk routing constants
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Frontend Client Endpoints
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_SERVER_URL=https://api.collabarch.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.collabarch.yourdomain.com/ws

